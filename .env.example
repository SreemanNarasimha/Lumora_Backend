# Required Environment Variables for Render (Backend)

# Database Config (Aiven MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<dbname>?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT Secret (generate a strong random string)
JWT_SECRET=

# Frontend URL for CORS (Vercel deployment URL)
FRONTEND_URL=

# Razorpay Config
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mail Config (for forgot password/OTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# Port is usually dynamically assigned by Render, so you may not need to set it manually
PORT=8080
